rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: Deny all direct client reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Waitlist Submissions: Only verified Admin client can read in real-time
    // All writes happen strictly through server-side Admin SDK
    match /waitlist_submissions/{submissionId} {
      allow read: if request.auth != null &&
                     request.auth.token.email.lower() == "chotimonino1@gmail.com" &&
                     request.auth.token.email_verified == true;
      allow write: if false;
    }

    // Visitors, Visitor Days & Daily Analytics:
    // Read and written exclusively via Server APIs using Admin SDK
    match /visitors/{visitorId} {
      allow read, write: if false;
    }

    match /visitor_days/{dayVisitorId} {
      allow read, write: if false;
    }

    match /analytics_daily/{day} {
      allow read, write: if false;
    }
  }
}
