rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: Deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email.lower() == "go.vayaus@gmail.com"
      );
    }

    // Waitlist Submissions:
    // - Public clients cannot directly write to this collection.
    // - All submissions MUST go through the server-side Next.js API (/api/waitlist) via Admin SDK.
    // - Read, Update, Delete are restricted strictly to verified Admins.
    match /waitlist_submissions/{submissionId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // Waitlist Email Keys (uniqueness lock collection):
    // Managed exclusively by server Admin SDK. Denied by default.
    match /waitlist_email_keys/{keyHash} {
      allow read, write: if false;
    }

    // Visitors, Visitor Days & Daily Analytics:
    // Written and read exclusively by server-side Firebase Admin SDK
    match /visitors/{visitorId} {
      allow read, write: if false;
    }

    match /visitor_days/{dayVisitorId} {
      allow read, write: if false;
    }

    match /analytics_daily/{day} {
      allow read, write: if false;
    }
  }
}
