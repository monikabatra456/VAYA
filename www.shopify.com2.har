\\\"_398\\\":3010,\\\"_402\\\":403,\\\"_404\\\":3013,\\\"_531\\\":532,\\\"_391\\\":-7,\\\"_533\\\":-7,\\\"_534\\\":3050,\\\"_612\\\":3012,\\\"_613\\\":178},\\\"simGymMain\\\",\\\"752:653\\\",\\\"A simulation test is run by AI changing the hero on the page, and then feedback is shared. \\\",{\\\"_199\\\":156,\\\"_203\\\":2999,\\\"_189\\\":3000,\\\"_153\\\":3001,\\\"_201\\\":1190},1800,\\\"gid://shopify/ImageSource/44136163115290\\\",\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U258_SimGym_desktop-fallback.png?v=1765318024\\\",{\\\"_199\\\":156,\\\"_203\\\":3003,\\\"_189\\\":3004,\\\"_153\\\":3005,\\\"_201\\\":3006},1470,\\\"gid://shopify/ImageSource/44136164098330\\\",\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U258_SimGym_mobile-fallback.png?v=1765318038\\\",1098,[3008],{\\\"_189\\\":384,\\\"_218\\\":385,\\\"_153\\\":386},\\\"478:600\\\",{\\\"_189\\\":3011,\\\"_218\\\":234,\\\"_153\\\":3012},\\\"gid://shopify/GenericFile/44136211415322\\\",\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/sim_gym_12_9.riv?v=1787919798\\\",{\\\"_3014\\\":3015,\\\"_3016\\\":3017,\\\"_3018\\\":3019,\\\"_3020\\\":3021,\\\"_3022\\\":3023,\\\"_3024\\\":3025,\\\"_3026\\\":3027,\\\"_3028\\\":3029,\\\"_3030\\\":3031,\\\"_3032\\\":3033,\\\"_3034\\\":3035,\\\"_3036\\\":3037,\\\"_3038\\\":3039,\\\"_3040\\\":3041,\\\"_3042\\\":3043,\\\"_3044\\\":3045,\\\"_3046\\\":3047,\\\"_3048\\\":3049},\\\"riveSimGymTextRun1\\\",\\\"The product categories overlap with the same item appearing in multiple places.\\\",\\\"riveSimGymTextRun2\\\",\\\"I found exactly what I was looking for within seconds using the search bar!\\\",\\\"riveSimGymTextRun3\\\",\\\"The Shop Pay button being so visible and easy to use was great.\\\",\\\"riveSimGymTextRun4\\\",\\\"Finding the \\\\\\\"About us\\\\\\\" page was difficult, consider making it easier to find.\\\",\\\"riveSimGymTextRun5\\\",\\\"The trust badges in checkout reassured me that my payment info is safe.\\\",\\\"riveSimGymTextRun6\\\",\\\"I loved seeing actual customer photos in the reviews section.\\\",\\\"riveSimGymTextRun7\\\",\\\"I couldn't find any information about the return policy, which made me hesitant.\\\",\\\"riveSimGymTextRun8\\\",\\\"Moving around the site was much easier than I expected!\\\",\\\"riveSimGymTextRun9\\\",\\\"I appreciate that the mobile menu doesn't require a lot of scrolling to find what I need.\\\",\\\"riveSimGymTextRun10\\\",\\\"The text was tiny so I had to zoom in, and then buttons were hard to press accurately.\\\",\\\"riveSimGymTextRun11\\\",\\\"New simulation\\\",\\\"riveSimGymTextRun12\\\",\\\"Hero collection changes\\\",\\\"riveSimGymTextRun13\\\",\\\"Name\\\",\\\"riveSimGymTextRun14\\\",\\\"Start simulation\\\",\\\"riveSimGymTextRun15\\\",\\\"Horizon 3.0.0\\\",\\\"riveSimGymTextRun16\\\",\\\"Pushing Boundaries Hero\\\",\\\"riveSimGymTextRun17\\\",\\\"Horizon 3.1.0\\\",\\\"riveSimGymTextRun18\\\",\\\"Art in Motion Hero\\\",{\\\"_3051\\\":3052,\\\"_3054\\\":3055,\\\"_3057\\\":3058,\\\"_3060\\\":3061,\\\"_3063\\\":3064,\\\"_3066\\\":3067,\\\"_3069\\\":3070,\\\"_3072\\\":3073,\\\"_3075\\\":3076,\\\"_3078\\\":3079,\\\"_3081\\\":3082,\\\"_3084\\\":3085,\\\"_3087\\\":3088,\\\"_3090\\\":3091,\\\"_3093\\\":3094,\\\"_3096\\\":3097,\\\"_3099\\\":3100,\\\"_3102\\\":3103,\\\"_3105\\\":3106,\\\"_3108\\\":3109,\\\"_3111\\\":3112,\\\"_3114\\\":3115,\\\"_3117\\\":3118,\\\"_3120\\\":3121,\\\"_3123\\\":3124,\\\"_3126\\\":3127,\\\"_3129\\\":3130,\\\"_3132\\\":3133,\\\"_3135\\\":3136,\\\"_3138\\\":3139,\\\"_3141\\\":3142,\\\"_3144\\\":3145,\\\"_3147\\\":3148,\\\"_3150\\\":3151,\\\"_3153\\\":3154,\\\"_3156\\\":3157,\\\"_3159\\\":3160,\\\"_3162\\\":3163,\\\"_3165\\\":3166,\\\"_3168\\\":3169,\\\"_3171\\\":3172,\\\"_3174\\\":3175,\\\"_3177\\\":3178,\\\"_3180\\\":3181,\\\"_3183\\\":3184,\\\"_3186\\\":3187,\\\"_3189\\\":3190,\\\"_3192\\\":3193,\\\"_3195\\\":3196,\\\"_3198\\\":3199,\\\"_608\\\":3201},\\\"rive_simgym_1-desktop\\\",{\\\"_153\\\":3053,\\\"_197\\\":-5},\\\"https://c