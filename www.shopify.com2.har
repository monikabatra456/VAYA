=300&amp;height=228&amp;crop=center 300w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U75_b2b_ACH_payments.png?v=1764042485&amp;width=500&amp;height=380&amp;crop=center 500w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U75_b2b_ACH_payments.png?v=1764042485&amp;width=700&amp;height=532&amp;crop=center 700w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U75_b2b_ACH_payments.png?v=1764042485&amp;width=900&amp;height=684&amp;crop=center 900w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U75_b2b_ACH_payments.png?v=1764042485&amp;width=1100&amp;height=836&amp;crop=center 1100w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U75_b2b_ACH_payments.png?v=1764042485&amp;width=1300&amp;height=988&amp;crop=center 1300w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U75_b2b_ACH_payments.png?v=1764042485&amp;width=1500&amp;height=1140&amp;crop=center 1500w\" width=\"100\" class=\"absolute left-0 top-0 size-full block object-cover\" draggable=\"false\" style=\"width:100%;aspect-ratio:1686/1281\"/></div></div></div><div><h3 id=\"card-heading-ach-payments-for-b2b\" class=\"mb-10 card-content-width bodycopy-1\">ACH payments for B2B</h3><div class=\"card-content-width\"><div class=\"rich-text mb-10 text-grey-dark bodycopy-1\"><p>Accept ACH bank payments at checkout with <a class=\"relative\" data-component-name=\"cta-inline-link\" href=\"https://www.shopify.com/payments?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\">Shopify Payments</a>, and charge saved accounts directly from the admin. Exclusive to Plus. US only.</p></div><a target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-center justify-center transition-colors outline-none ring-focus ring-offset-0 disabled:cursor-not-allowed focus-visible:ring-1 gap-5 py-3 rounded-3 bg-light border-1 border-grey-light min-h-[26px] md:min-h-21 active:bg-dark active:border-dark hover:bg-grey-light disabled:opacity-50 disabled:active:bg-light disabled:active:border-grey-light disabled:focus-visible:bg-light disabled:hover:bg-light pl-5 pr-3 pointer-events-auto no-underline!\" data-component-name=\"cta-link\" href=\"https://help.shopify.com/en/manual/payments/shopify-payments/local-payment-methods/ach?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\"><span class=\"bodycopy-2 text-dark text-left transition-colors group-active:text-light group-disabled:active:text-dark\">Read help doc</span><div class=\"block place-content-center place-items-center [&amp;&gt;svg]:mx-auto rounded-xs size-13 transition-colors shrink-0 mt-[1px] md:mt-0 bg-light border-1 border-inherit text-dark group-active:border-light [&amp;&gt;svg]:size-7\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 7 7\" aria-label=\"Opens a new window\" role=\"img\"><path fill=\"currentColor\" d=\"m5.105 5.112-.078-2.397-3.599 3.599-.75-.75 3.6-3.599-2.397-.078v-.99l4.058.156.163 4.066-.997-.007Z\"></path></svg></div></a></div></div></article><article class=\"card-container col-span-2 sm-tablet:col-span-1 md:col-span-6 space-y-10\" id=\"suppliers-can-discover-retailers\" data-component-name=\"product\" data-component-extra-handle=\"suppliers-can-discover-retailers\"><div class=\"media-wrapper relative\"><div style=\"aspect-ratio:562 / 325\" class=\"\"><div data-viewable-component=\"true\" data-component-name=\"rive-container\" class=\"relative w-full max-w-full animate-show-media\" style=\"aspect-ratio:562 / 325\"><div class=\"absolute left-0 top-0 size-full block\"><img alt=\"A search bar shows a supplier looking for skateboards to sell. \" decoding=\"async\" loading=\"lazy\" sizes=\"(min-width: 940px) 40vw, (min-width: 768px) 50vw, 100vw\" src=\"https://cdn.shopify.com/b/shopify-brochure2-assets/786dd1f1b8096bb6116dcbf0fe12893a.png?width=100&amp;crop=center\" srcSet=\"https://cdn.shopify.com/b/shopify-brochure2-assets/786dd1f1b8096bb6116dcbf0