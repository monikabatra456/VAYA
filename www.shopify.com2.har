,{\\\"_366\\\":1183,\\\"_368\\\":1184,\\\"_49\\\":1185,\\\"_258\\\":1186,\\\"_262\\\":1191,\\\"_381\\\":1196,\\\"_388\\\":12,\\\"_389\\\":1198,\\\"_391\\\":1199,\\\"_398\\\":1205,\\\"_402\\\":403,\\\"_404\\\":1208,\\\"_531\\\":532,\\\"_533\\\":-7,\\\"_534\\\":1257,\\\"_612\\\":1207,\\\"_613\\\":178},\\\"flowMain\\\",\\\"752:740\\\",\\\"A sidekick prompt field asking to be emailed when any product inventory drops below 5. The flow is then created.\\\",{\\\"_199\\\":156,\\\"_203\\\":1187,\\\"_189\\\":1188,\\\"_153\\\":1189,\\\"_201\\\":1190},2220,\\\"gid://shopify/ImageSource/44135943667994\\\",\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U1_sidekick_flow_desktop-fallback.png?v=1765316138\\\",2256,{\\\"_199\\\":156,\\\"_203\\\":1192,\\\"_189\\\":1193,\\\"_153\\\":1194,\\\"_201\\\":1195},1881,\\\"gid://shopify/ImageSource/44135962116378\\\",\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U1_sidekick_flow_mobile-fallback.png?v=1765316150\\\",1113,[1197],{\\\"_189\\\":384,\\\"_218\\\":385,\\\"_153\\\":386},\\\"432:740\\\",{\\\"_197\\\":1200},{\\\"_199\\\":156,\\\"_203\\\":1201,\\\"_189\\\":1202,\\\"_153\\\":1203,\\\"_201\\\":1204},1480,\\\"gid://shopify/ImageSource/44125154869530\\\",\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/default_abdd996f-1b4e-44a5-bfcc-8addca857894.png?v=1765164459\\\",1504,{\\\"_189\\\":1206,\\\"_218\\\":234,\\\"_153\\\":1207},\\\"gid://shopify/GenericFile/44134347768090\\\",\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/flow_12_9.riv?v=1787919786\\\",{\\\"_1209\\\":1210,\\\"_1211\\\":1212,\\\"_1213\\\":1214,\\\"_1215\\\":1216,\\\"_1217\\\":1218,\\\"_1219\\\":1220,\\\"_1221\\\":1222,\\\"_1223\\\":1224,\\\"_1225\\\":1226,\\\"_1227\\\":1228,\\\"_1229\\\":1230,\\\"_1231\\\":1232,\\\"_1233\\\":1234,\\\"_1235\\\":1236,\\\"_1237\\\":1238,\\\"_1239\\\":1240,\\\"_1241\\\":1242,\\\"_1243\\\":1244,\\\"_1245\\\":1246,\\\"_1247\\\":1248,\\\"_1249\\\":1250,\\\"_1251\\\":1252,\\\"_1253\\\":1254,\\\"_1255\\\":1256},\\\"flowMain/riveFlowTextRun1\\\",\\\"Ask anything...\\\",\\\"flowMain/riveFlowTextRun2\\\",\\\"Email alert for low inventory (below 5)\\\",\\\"sidekick/riveFlowTextRun3\\\",\\\"I'll create a workflow that monitors inventory levels and emails you when any product variant drops below 5 for the first time.\\\",\\\"sidekick/riveFlowTextRun4\\\",\\\"1.\\\",\\\"sidekick/riveFlowTextRun5\\\",\\\"Trigger:\\\",\\\"sidekick/riveFlowTextRun6\\\",\\\"Monitors inventory changes for all product variants in your store\\\",\\\"sidekick/riveFlowTextRun7\\\",\\\"2.\\\",\\\"sidekick/riveFlowTextRun8\\\",\\\"Condition:\\\",\\\"sidekick/riveFlowTextRun9\\\",\\\"Checks if inventory drops below 5 for the first time (current inventory is less than 5 AND previous inventory was 5 or more)\\\",\\\"sidekick/riveFlowTextRun10\\\",\\\"3.\\\",\\\"sidekick/riveFlowTextRun11\\\",\\\"Action:\\\",\\\"sidekick/riveFlowTextRun12\\\",\\\"Sends you an email with details including the product name, variant, current inventory level, previous inventory level, and SKU\\\",\\\"flow/riveFlowTextRun13\\\",\\\"Product variant inventory quantity changed\\\",\\\"flow/riveFlowTextRun14\\\",\\\"This workflow starts when the inventory level changes for a specific product variant.\\\",\\\"flow/riveFlowTextRun15\\\",\\\"Condition\\\",\\\"flow/riveFlowTextRun16\\\",\\\"Product variant inventory quantity is less than 5.0\\\",\\\"flow/riveFlowTextRun17\\\",\\\"AND\\\",\\\"flow/riveFlowTextRun18\\\",\\\"Inventory quantity prior is greater than or equal to 5.0\\\",\\\"flow/riveFlowTextRun19\\\",\\\"True\\\",\\\"flow/riveFlowTextRun20\\\",\\\"False\\\",\\\"flow/riveFlowTextRun21\\\",\\\"Send internal email\\\",\\\"flow/riveFlowTextRun22\\\",\\\"Send email to david@mvseskate.com with the following subject:\\\",\\\"flow/riveFlowTextRun23\\\",\\\"Low Inventory Alert: {{productVariant.displayName}}\\\",\\\"flowMain/riveFlowTextRun24\\\",\\\"Create a workflow to email me when inventory for any variant drops below 5 for the 