5,\\\"_433\\\":413,\\\"_434\\\":435,\\\"_436\\\":419,\\\"_437\\\":415,\\\"_438\\\":413,\\\"_439\\\":440,\\\"_441\\\":419,\\\"_442\\\":415,\\\"_443\\\":413,\\\"_444\\\":445,\\\"_446\\\":419,\\\"_447\\\":118,\\\"_448\\\":449,\\\"_450\\\":451,\\\"_452\\\":453,\\\"_454\\\":455,\\\"_456\\\":457,\\\"_458\\\":459,\\\"_460\\\":461,\\\"_462\\\":463,\\\"_464\\\":465,\\\"_466\\\":467,\\\"_468\\\":469,\\\"_470\\\":471,\\\"_472\\\":473,\\\"_474\\\":475,\\\"_476\\\":477,\\\"_478\\\":479,\\\"_480\\\":481,\\\"_482\\\":483,\\\"_484\\\":413,\\\"_485\\\":486,\\\"_487\\\":417,\\\"_488\\\":489,\\\"_490\\\":491,\\\"_492\\\":493,\\\"_494\\\":495,\\\"_496\\\":497,\\\"_498\\\":499,\\\"_500\\\":501,\\\"_502\\\":503,\\\"_504\\\":505,\\\"_506\\\":507,\\\"_508\\\":118,\\\"_509\\\":449,\\\"_510\\\":486,\\\"_511\\\":417,\\\"_512\\\":489,\\\"_513\\\":491,\\\"_514\\\":493,\\\"_515\\\":495,\\\"_516\\\":497,\\\"_517\\\":499,\\\"_518\\\":501,\\\"_519\\\":503,\\\"_520\\\":505,\\\"_521\\\":507,\\\"_522\\\":523,\\\"_524\\\":525,\\\"_526\\\":527,\\\"_528\\\":523,\\\"_529\\\":525,\\\"_530\\\":527},\\\"digestMain/rivePulseTextRun1\\\",\\\"Unfulfilled\\\",\\\"digestMain/rivePulseTextRun2\\\",\\\"$189,657.98\\\",\\\"digestMain/rivePulseTextRun3\\\",\\\"Total sales\\\",\\\"digestMain/rivePulseTextRun4\\\",\\\"Pulse\\\",\\\"digestMain/rivePulseTextRun5\\\",\\\"New\\\",\\\"digestMain/rivePulseTextRun6\\\",\\\"New year momentum: convert, bundle, and scale\\\",\\\"digestMain/rivePulseTextRun7\\\",\\\"Explore your Pulse\\\",\\\"digestMain/rivePulseTextRun8\\\",\\\"Paid\\\",\\\"digestMain/rivePulseTextRun9\\\",\\\"digestMain/rivePulseTextRun10\\\",\\\"digestMain/rivePulseTextRun11\\\",\\\"From foot traffic to omnichannel growth\\\",\\\"digestMain/rivePulseTextRun12\\\",\\\"digestMain/rivePulseTextRun13\\\",\\\"digestMain/rivePulseTextRun14\\\",\\\"digestMain/rivePulseTextRun15\\\",\\\"Grow AOV and bring buyers back\\\",\\\"digestMain/rivePulseTextRun16\\\",\\\"digestMain/rivePulseTextRun17\\\",\\\"digestMain/rivePulseTextRun18\\\",\\\"digestMain/rivePulseTextRun19\\\",\\\"Own the spring cleaning rush\\\",\\\"digestMain/rivePulseTextRun20\\\",\\\"digestMain/rivePulseTextRun21\\\",\\\"digestMain/rivePulseTextRun22\\\",\\\"digestMain/rivePulseTextRun23\\\",\\\"Fix stockouts, unlock smarter growth\\\",\\\"digestMain/rivePulseTextRun24\\\",\\\"digestMain/rivePulseTextRun25\\\",\\\"digestMain/rivePulseTextRun26\\\",\\\"digestMain/rivePulseTextRun27\\\",\\\"Restock, retain, and raise the value of every order\\\",\\\"digestMain/rivePulseTextRun28\\\",\\\"pulseDesktop/rivePulseTextRun29\\\",\\\"pulseDesktop/rivePulseTextRun30\\\",\\\"MVSE\\\",\\\"pulseDesktop/rivePulseTextRun31\\\",\\\"Home\\\",\\\"pulseDesktop/rivePulseTextRun32\\\",\\\"Orders\\\",\\\"pulseDesktop/rivePulseTextRun33\\\",\\\"Products\\\",\\\"pulseDesktop/rivePulseTextRun34\\\",\\\"Customers\\\",\\\"pulseDesktop/rivePulseTextRun35\\\",\\\"Marketing\\\",\\\"pulseDesktop/rivePulseTextRun36\\\",\\\"Discounts\\\",\\\"pulseDesktop/rivePulseTextRun37\\\",\\\"Content\\\",\\\"pulseDesktop/rivePulseTextRun38\\\",\\\"Markets\\\",\\\"pulseDesktop/rivePulseTextRun39\\\",\\\"Finances\\\",\\\"pulseDesktop/rivePulseTextRun40\\\",\\\"Analytics\\\",\\\"pulseDesktop/rivePulseTextRun41\\\",\\\"Online Store\\\",\\\"pulseDesktop/rivePulseTextRun42\\\",\\\"Point of Sale\\\",\\\"pulseDesktop/rivePulseTextRun43\\\",\\\"Shop\\\",\\\"pulseDesktop/rivePulseTextRun44\\\",\\\"Pulse: New year momentum\\\",\\\"pulseDesktop/rivePulseTextRun45\\\",\\\"Build staff onboarding app\\\",\\\"pulseDesktop/rivePulseTextRun46\\\",\\\"Discounts for email campaign\\\",\\\"pulseDesktop/rivePulseTextRun47\\\",\\\"Settings\\\",\\\"pulseDesktop/rivePulseTextRun48\\\",\\\"pulseDesktop/rivePulseTextRun49\\\",\\\"3 next actions\\\",\\\"pulseDesktop/rivePulseTextRun50\\\",\\\"pulseDesktop/rivePulseTextRun51\\\",\\\"Week of Dec 10\\\",\\\"pulseDesktop/rivePulseTextRun52\\\",\\\"A/B test a free shipping threshold to lift average order value\\\",\\\"pulseDesktop/rivePulseTextRun53\\\",\\\"Your discounted orders already outperform full-price, showing that customers respond to incentives. With a 65.2% margin, you could test a free shipping threshold to raise AOV, without a major hit to shipping costs. Consider A/B testing a $175 threshold for 2–4 weeks and adding cart messaging like \\\\\\\"Add $X more for free shipping.\\\\\\\"\\\",\\\"pulseDesktop/rivePulseTextRun54\\\",\\\"Test free shipping threshold\\\",\\\"pulseDesktop/rivePulseTextRun55\\\",\\\"Set up abandoned cart emails to recover lost sales\\\",\\\"pulseDesktop/rivePulseTextRun56\\\",\\\"Your store sees 257 shoppers reach checkout each month, but only about half finish their purchase, leaving many carts behind. Automating abandoned cart emails can help you win back these lost orders, with industry stats showing 10–20% of shopper return to complete their purchase when prompted. Setting up a follow-up email series is an effective way to turn missed opportunities into extra revenue each month.\\\",\\\"pulseDesktop/rivePulseTextRun57\\\",\\\"Build cart recovery strategy\\\",\\\"pulseDesktop/rivePulseTextRun58\\\",\\\"Launch a new year campaign targeting your clothing bestsellers to boost seasonal revenue\\\",\\\"pulseDesktop/rivePulseTextRun59\\\",\\\"Hearthside Hoodies did $487k in organic sales in 90 days. Consider launching a 25% off \\\\\\\"Hoodie Season\\\\\\\" promo with 15% off hoodie + beanie bundles, gift card offers, segmented emails, and refreshed copy focused on gifting and winter layering.\\\",\\\"pulseDesktop/rivePulseTextRun61\\\",\\\"Build new year campaign now\\\",\\\"pulseMobile/rivePulseTextRun62\\\",\\\"pulseMobile/rivePulseTextRun63\\\",\\\"pulseMobile/rivePulseTextRun64\\\",\\\"pulseMobile/rivePulseTextRun65\\\",\\\"pulseMobile/rivePulseTextRun66\\\",\\\"pulseMobile/rivePulseTextRun67\\\",\\\"pulseMobile/rivePulseTextRun68\\\",\\\"pulseMobile/rivePulseTextRun69\\\",\\\"pulseMobile/rivePulseTextRun70\\\",\\\"pulseMobile/rivePulseTextRun71\\\",\\\"pulseMobile/rivePulseTextRun72\\\",\\\"pulseMobile/rivePulseTextRun73\\\",\\\"pulseMobile/rivePulseTextRun74\\\",\\\"pulseMobile/rivePulseTextRun75\\\",\\\"pulseDesktop/rivePulseTextRun76\\\",\\\"Run an A/B test to drive increased basket sizes while protecting your 65% gross margin.\\\",\\\"pulseDesktop/rivePulseTextRun77\\\",\\\"Set up reminder emails with segmented messaging to recover abandoned checkouts.\\\",\\\"pulseDesktop/rivePulseTextRun78\\\",\\\"Create a promo bundle, gift card offers, and segmented emails to capture more seasonal revenue.\\\",\\\"pulseMobile/rivePulseTextRun79\\\",\\\"pulseMobile/rivePulseTextRun80\\\",\\\"pulseMobile/rivePulseTextRun81\\\",\\\"viewModelName\\\",\\\"View Model 1\\\",\\\"posterImageMobile\\\",\\\"assetsMap\\\",{\\\"_536\\\":537,\\\"_539\\\":540,\\\"_542\\\":543,\\\"_545\\\":546,\\\"_548\\\":549,\\\"_551\\\":552,\\\"_554\\\":555,\\\"_557\\\":558,\\\"_560\\\":561,\\\"_563\\\":564,\\\"_566\\\":567,\\\"_569\\\":570,\\\"_572\\\":573,\\\"_575\\\":576,\\\"_578\\\":579,\\\"_581\\\":582,\\\"_584\\\":585,\\\"_587\\\":588,\\\"_590\\\":591,\\\"_593\\\":594,\\\"_596\\\":597,\\\"_599\\\":600,\\\"_602\\\":603,\\\"_605\\\":606,\\\"_608\\\":609},\\\"rive_digest_1-desktop\\\",{\\\"_153\\\":538,\\\"_197\\\":-5},\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/rive_digest_1-desktop.webp?v=1763060510\\\",\\\"rive_digest_1-mobile\\\",{\\\"_153\\\":541,\\\"_197\\\":-5},\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/rive_digest_1-mobile.webp?v=1763060509\\\",\\\"rive_digest_2-desktop\\\",{\\\"_153\\\":544,\\\"_197\\\":-5},\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/rive_digest_2-desktop.webp?v=1763060510\\\",\\\"rive_digest_2-mobile\\\",{\\\"_153\\\":547,\\\"_197\\\":-5},\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/rive_digest_2-mobile.webp?v=1763060509\\\",\\\"rive_digest_3-desktop\\\",{\\\"_153\\\":550,\\\"_197\\\":-5},\\\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/rive_digest_3-desktop.webp?v=