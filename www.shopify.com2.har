-50 disabled:active:bg-light disabled:active:border-grey-light disabled:focus-visible:bg-light disabled:hover:bg-light pl-5 pr-3 pointer-events-auto no-underline!\" data-component-name=\"cta-link\" href=\"https://help.shopify.com/en/manual/shopify-admin/shopify-app/quick-sale?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\"><span class=\"bodycopy-2 text-dark text-left transition-colors group-active:text-light group-disabled:active:text-dark\">Read help doc</span><div class=\"block place-content-center place-items-center [&amp;&gt;svg]:mx-auto rounded-xs size-13 transition-colors shrink-0 mt-[1px] md:mt-0 bg-light border-1 border-inherit text-dark group-active:border-light [&amp;&gt;svg]:size-7\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 7 7\" aria-label=\"Opens a new window\" role=\"img\"><path fill=\"currentColor\" d=\"m5.105 5.112-.078-2.397-3.599 3.599-.75-.75 3.6-3.599-2.397-.078v-.99l4.058.156.163 4.066-.997-.007Z\"></path></svg></div></a></div></div></article><article class=\"card-container col-span-2 md:col-span-4 sm-tablet:col-span-2 space-y-10\" id=\"updated-metrics-and-widgets-for-apple-watch\" data-component-name=\"product\" data-component-extra-handle=\"updated-metrics-and-widgets-for-apple-watch\"><div class=\"media-wrapper relative\"><img alt=\"\" decoding=\"async\" height=\"66.66666666666666\" loading=\"lazy\" sizes=\"(min-width: 940px) 26vw, (min-width: 768px) 33vw, 50vw\" src=\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=100&amp;height=67&amp;crop=center\" srcSet=\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=300&amp;height=200&amp;crop=center 300w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=500&amp;height=333&amp;crop=center 500w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=700&amp;height=467&amp;crop=center 700w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=900&amp;height=600&amp;crop=center 900w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=1100&amp;height=733&amp;crop=center 1100w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=1300&amp;height=867&amp;crop=center 1300w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=1500&amp;height=1000&amp;crop=center 1500w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/BG-R.png?v=1761935402&amp;width=1700&amp;height=1133&amp;crop=center 1700w\" width=\"100\" class=\"absolute inset-0 w-full h-full object-cover pointer-events-none user-select-none transition-opacity duration-300\" style=\"width:100%;aspect-ratio:1800/1200;object-position:bottom;opacity:0\"/><div style=\"aspect-ratio:1113 / 1245\" class=\"\"><div class=\"relative w-full max-w-full animate-show-media\" style=\"aspect-ratio:1113 / 1245\"><img alt=\"An Apple Watch with the redesigned Shopify app that shows the total sales and the total sessions. \" decoding=\"async\" height=\"111.85983827493263\" loading=\"lazy\" sizes=\"(min-width: 940px) 26vw, (min-width: 768px) 33vw, 50vw\" src=\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U133_Apple_watch_app_redesign.png?v=1764791708&amp;width=100&amp;height=112&amp;crop=center\" srcSet=\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U133_Apple_watch_app_redesign.png?v=1764791708&amp;width=300&amp;height=336&amp;crop=center 300w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U133_Apple_watch_app_redesign.png?v=1764791708&amp;width=500&amp;height=559&amp;crop=center 500w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U133_Apple_watch_app_redesign.png?v=1764791708&amp;width=700&amp;height=783&amp;crop=center 700w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U133_Apple_watch_app_redesign.png?v=1764791708&amp;width=900&amp;height=1007&amp;crop=center 900w, https://cdn.shopify.com/s/files/1/0951/3130/4218/files/U133_Apple_watch_app_redesign.png?v=1764791708&amp;width=1100&amp;height=1230&amp;crop=center 1100w\" width=\"100\" class=\"absolute left-0 top-0 size-full block object-cover\" draggable=\"false\" style=\"width:100%;aspect-ratio:1113/1245\"/></div></div></div><div><h3 id=\"card-heading-updated-metrics-and-widgets-for-apple-watch\" class=\"mb-10 card-content-width bodycopy-1\">Updated metrics and widgets for Apple Watch</h3><div class=\"card-content-width\"><div class=\"rich-text mb-10 text-grey-dark bodycopy-1\"><p>Monitor your store from your wrist with quick access to key metrics and customizable widgets.</p></div><a target=\"_blank\" rel=\"noopener noreferrer\" class=\"group inline-flex items-center justify-center transition-colors outline-none ring-focus ring-offset-0 disabled:cursor-not-allowed focus-visible:ring-1 gap-5 py-3 rounded-3 bg-light border-1 border-grey-light min-h-[26px] md:min-h-21 active:bg-dark active:border-dark hover:bg-grey-light disabled:opacity-50 disabled:active:bg-light disabled:active:border-grey-light disabled:focus-visible:bg-light disabled:hover:bg-light pl-5 pr-3 pointer-events-auto no-underline!\" data-component-name=\"cta-link\" href=\"https://help.shopify.com/manual/shopify-admin/shopify-app/watch-app?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\"><span class=\"bodycopy-2 text-dark text-left transition-colors group-active:text-light group-disabled:active:text-dark\">Read help doc</span><div class=\"block place-content-center place-items-center [&amp;&gt;svg]:mx-auto rounded-xs size-13 transition-colors shrink-0 mt-[1px] md:mt-0 bg-light border-1 border-inherit text-dark group-active:border-light [&amp;&gt;svg]:size-7\"><svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 7 7\" aria-label=\"Opens a new window\" role=\"img\"><path fill=\"currentColor\" d=\"m5.105 5.112-.078-2.397-3.599 3.599-.75-.75 3.6-3.599-2.397-.078v-.99l4.058.156.163 4.066-.997-.007Z\"></path></svg></div></a></div></div></article><div class=\"col-span-2 md:col-span-12 relative px-grid-spacing md:px-grid-spacing-md full-bleed bg-grey-light py-40 lg:py-60 \"><div class=\"absolute inset-0 pointer-events-none bg-repeat\" aria-hidden=\"true\"><img src=\"https://cdn.shopify.com/s/files/1/0951/3130/4218/files/texture-src-90.jpg\" alt=\"\" loading=\"lazy\" class=\"size-1 opacity-0\"/></div><div class=\"grid grid-cols-2 md:grid-cols-12 gap-x-grid-spacing md:gap-x-grid-spacing-md gap-y-30 relative\"><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"ai-enhanced-chargeback-management\" data-component-name=\"product\" data-component-extra-handle=\"ai-enhanced-chargeback-management\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/payments/shopify-payments/managing-chargebacks/chargebacks-shopify-admin?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#add-evidence-and-submit-a-chargeback\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">AI-enhanced chargeback management</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Auto-generate dispute summaries that include key factors like delivery tracking and your policies.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"password-free-login\" data-component-name=\"product\" data-component-extra-handle=\"password-free-login\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://accounts.shopify.com/account/security?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Password-free login</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Set up passkeys to access your store securely with your fingerprint, face, or PIN.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"heatmaps-in-analytics\" data-component-name=\"product\" data-component-extra-handle=\"heatmaps-in-analytics\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/reports-and-analytics/shopify-reports/report-types/reports-overview?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#visualizations\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Heatmaps in analytics</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>View data as a heatmap across two variables, such as sales by hour and day of the week to spot your highest selling time.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"customizable-top-items-in-analytics\" data-component-name=\"product\" data-component-extra-handle=\"customizable-top-items-in-analytics\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/reports-and-analytics/shopify-reports/report-types/custom-reports/filter-and-edit?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#customize-top-items-visualizations\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Customizable top items in analytics</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Get a flexible view of reports by configuring the number of items displayed in visualizations, no longer limited to five.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"bot-filtering-in-analytics\" data-component-name=\"product\" data-component-extra-handle=\"bot-filtering-in-analytics\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/intro-to-shopify/bots/bot-filtering?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Bot filtering in analytics</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Exclude bot traffic for more accurate conversion rates and cleaner data.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"comprehensive-inventory-history\" data-component-name=\"product\" data-component-extra-handle=\"comprehensive-inventory-history\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/products/inventory/adjusting-inventory/adjustment-history?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Comprehensive inventory history</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Access full inventory adjustment history with the removal of the 180-day cap.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"precise-date-and-time-controls-for-analytics\" data-component-name=\"product\" data-component-extra-handle=\"precise-date-and-time-controls-for-analytics\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/reports-and-analytics/shopify-reports/report-types/custom-reports/time-ranges?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Precise date and time controls for analytics</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Monitor flash sales and product drops with filters that show data down to the minute.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"flash-sales-with-multi-location-inventory\" data-component-name=\"product\" data-component-extra-handle=\"flash-sales-with-multi-location-inventory\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/products/inventory/setup/selling-when-out-of-stock?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Flash sales with multi-location inventory</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Run flash sales without overselling using inventory from multiple locations.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"single-view-analytics-for-multiple-stores\" data-component-name=\"product\" data-component-extra-handle=\"single-view-analytics-for-multiple-stores\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/organization-settings/analytics?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#multi-store-reporting\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Single-view analytics for multiple stores</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>See organization-wide performance in one view, then filter by store and compare metrics. Exclusive to Plus.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"bin-locations-in-the-order-printer-app\" data-component-name=\"product\" data-component-extra-handle=\"bin-locations-in-the-order-printer-app\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/products/inventory/setup/bin-locations?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Bin locations in the Order Printer app</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Pick orders faster by assigning bin locations to each SKU using a CSV or the bulk editor in the <span class=\"group relative\"><a class=\"relative peer\" aria-describedby=\"tooltipID_:R1clp5nq35:_order printer\" data-component-name=\"cta-inline-link\" href=\"https://apps.shopify.com/shopify-order-printer?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\">Order Printer</a><span id=\"tooltipID_:R1clp5nq35:_order printer\" role=\"tooltip\" aria-label=\"Get app\" style=\"--tooltip-content:&quot;Get app&quot;\" class=\"hidden opacity-0 group-hover:opacity-100 peer-focus:opacity-100 md:inline-block tooltip\"></span></span> app.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"more-order-filtering-capabilities\" data-component-name=\"product\" data-component-extra-handle=\"more-order-filtering-capabilities\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/fulfillment/managing-orders/viewing-orders?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">More order filtering capabilities</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Filter orders by custom metafields, total value, and weight for smarter fulfillment workflows in admin.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"edit-unfulfilled-orders-with-duties\" data-component-name=\"product\" data-component-extra-handle=\"edit-unfulfilled-orders-with-duties\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/fulfillment/managing-orders/editing-orders/considerations?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#taxes-duties\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Edit unfulfilled orders with duties</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Duties, taxes, and totals recalculate automatically when making changes to unfulfilled orders.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"smarter-safeguards-for-inventory-updates\" data-component-name=\"product\" data-component-extra-handle=\"smarter-safeguards-for-inventory-updates\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/products/inventory/adjusting-inventory/bulk-editing-inventory?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#edit-properties\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Smarter safeguards for inventory updates</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Prevent accidental overrides when you save bulk edits with color-coded changes, a warning, and a confirmation step.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"discounts-on-fulfilled-items\" data-component-name=\"product\" data-component-extra-handle=\"discounts-on-fulfilled-items\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/fulfillment/managing-orders/editing-orders/discounts?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Discounts on fulfilled items</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Issue refunds by applying discounts to fulfilled products for accurate taxes and reporting.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"preview-workflow-results-in-shopify-flow\" data-component-name=\"product\" data-component-extra-handle=\"preview-workflow-results-in-shopify-flow\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://www.shopify.com/blog/flow-automation-updates-2025?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Preview workflow results in Flow</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Test workflows in the <span class=\"group relative\"><a class=\"relative peer\" aria-describedby=\"tooltipID_:R1cvp5nq35:_shopify-flow\" data-component-name=\"cta-inline-link\" href=\"https://apps.shopify.com/flow?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\">Shopify Flow</a><span id=\"tooltipID_:R1cvp5nq35:_shopify-flow\" role=\"tooltip\" aria-label=\"Get app\" style=\"--tooltip-content:&quot;Get app&quot;\" class=\"hidden opacity-0 group-hover:opacity-100 peer-focus:opacity-100 md:inline-block tooltip\"></span></span> app before going live and adjust logic without impacting real store data.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"redesigned-shopify-flow-editor\" data-component-name=\"product\" data-component-extra-handle=\"redesigned-shopify-flow-editor\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://www.shopify.com/blog/flow-automation-updates-2025?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Redesigned Flow editor</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Build large automations in the <span class=\"group relative\"><a class=\"relative peer\" aria-describedby=\"tooltipID_:R1d1p5nq35:_shopify-flow\" data-component-name=\"cta-inline-link\" href=\"https://apps.shopify.com/flow?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\">Shopify Flow</a><span id=\"tooltipID_:R1d1p5nq35:_shopify-flow\" role=\"tooltip\" aria-label=\"Get app\" style=\"--tooltip-content:&quot;Get app&quot;\" class=\"hidden opacity-0 group-hover:opacity-100 peer-focus:opacity-100 md:inline-block tooltip\"></span></span> app with more workspace in the vertical layout.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"cancel-workflow-runs-in-shopify-flow\" data-component-name=\"product\" data-component-extra-handle=\"cancel-workflow-runs-in-shopify-flow\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/shopify-flow/manage/monitor?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#cancelling-runs\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Cancel workflow runs in Flow</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Stop automations by cancelling a run or multiple runs in the <span class=\"group relative\"><a class=\"relative peer\" aria-describedby=\"tooltipID_:R1d3p5nq35:_shopify flow\" data-component-name=\"cta-inline-link\" href=\"https://apps.shopify.com/flow?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\">Shopify Flow</a><span id=\"tooltipID_:R1d3p5nq35:_shopify flow\" role=\"tooltip\" aria-label=\"Get app\" style=\"--tooltip-content:&quot;Get app&quot;\" class=\"hidden opacity-0 group-hover:opacity-100 peer-focus:opacity-100 md:inline-block tooltip\"></span></span> app.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"store-credit-email-notifications\" data-component-name=\"product\" data-component-extra-handle=\"store-credit-email-notifications\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/customers/store-credit?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition#issue\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Store credit email notifications</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Notify customers when store credit has been issued with a customizable email.</p></div></div></article></div><div class=\"col-span-2 md:col-span-5 md:even:col-start-7\"><article id=\"enhanced-managed-markets\" data-component-name=\"product\" data-component-extra-handle=\"enhanced-managed-markets\"><div class=\"flex flex-col gap-10 lg:grid lg:grid-cols-5 lg:gap-x-grid-spacing-md\"><h3 class=\"bodycopy-1 font-bold lg:col-span-2\"><a href=\"https://help.shopify.com/en/manual/international/managed-markets/overview?utm_source=w26-editions-website&amp;utm_medium=product-cta&amp;utm_campaign=winter26edition\" target=\"_blank\" rel=\"noreferrer\" class=\"list-title-link no-underline hover:underline\" data-component-name=\"cta-title-link\">Enhanced Managed Markets</a></h3><div class=\"rich-text bodycopy-1 text-grey-mid lg:col-span-3\"><p>Sell internationally with instant compliance checks, faster payouts, and full Harmonized System code control. US only.</p></div></div></article></div></div></div></div></div>